[
  {
    "claim": "Personal-site author remains Rasul Kireev",
    "paths": [
      "src/layouts/PostLayout.astro"
    ],
    "must_match": [
      "Rasul Kireev"
    ],
    "must_not_match": []
  },
  {
    "claim": "Site content remains file-backed Astro collections",
    "paths": [
      "src/pages/*.astro"
    ],
    "must_match": [
      "getCollection"
    ],
    "must_not_match": []
  },
  {
    "claim": "Jupyter tutorial uses the documented Windows cmd activation script",
    "paths": ["src/content/tutorials/venv-for-jupyter-notebook.md"],
    "must_match": ["Windows Command Prompt", "\\.\\\\DS\\\\Scripts\\\\activate\\.bat"],
    "must_not_match": ["actvate\\.bat"]
  },
  {
    "claim": "Existing Poetry setup examples use the current official installer",
    "paths": [
      "src/content/tutorials/django-poetry.md",
      "src/content/tutorials/create-an-ethereum-token-on-polygon-with-python.md"
    ],
    "must_match": [
      "curl -sSL https://install\\.python-poetry\\.org \\| python3 -"
    ],
    "must_not_match": [
      "get-poetry\\.py"
    ]
  },
  {
    "claim": "Django guide documents Poetry2 shell and export plugin prerequisites",
    "paths": [
      "src/content/tutorials/django-poetry.md"
    ],
    "must_match": [
      "poetry self add poetry-plugin-shell",
      "poetry self add poetry-plugin-export",
      "original walkthrough"
    ],
    "must_not_match": []
  },
  {
    "claim": "Django venv guide distinguishes Windows shells and directory listing",
    "paths": [
      "src/content/tutorials/setting-up-python-virtual-environment.md"
    ],
    "must_match": [
      "Windows Command Prompt \\(cmd\\.exe\\)",
      "Windows PowerShell",
      "REM to activate",
      "\\.\\\\venv\\\\Scripts\\\\activate\\.bat",
      "\\.\\\\venv\\\\Scripts\\\\Activate\\.ps1",
      "`dir` in Windows Command Prompt"
    ],
    "must_not_match": [
      "typing `ls` to the command prompt",
      "On Windows:\\s*```"
    ]
  },
  {
    "claim": "Code Book public notes do not expose private reading-app links and link Chapter6 to the existing published heading",
    "paths": [
      "src/content/books/the-code-book.md"
    ],
    "must_match": [
      "\\[Chapter 6\\]\\(#6-alice-and-bob-go-public\\)",
      "### 6 Alice and Bob Go Public"
    ],
    "must_not_match": [
      "private://"
    ]
  }
]
