---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  photos: { src: ImageMetadata; alt: string }[];
}
const { photos } = Astro.props;
---

<review-photos class="block" role="region" aria-label="Review photos">
  <ul data-slides tabindex={photos.length > 1 ? 0 : undefined}
    class="flex overflow-x-auto snap-x snap-mandatory rounded-lg focus-visible:outline-blue-700">
    {photos.map((photo, index) => (
      <li class="w-full shrink-0 snap-start">
        <Image src={photo.src} alt={photo.alt} loading={index === 0 ? 'eager' : 'lazy'}
          class="aspect-[2/1] w-full object-cover" />
      </li>
    ))}
  </ul>
  {photos.length > 1 && <div data-controls hidden class="mt-2 text-sm text-gray-700">
    <div class="flex items-center justify-end gap-3">
      <button type="button" data-prev aria-label="Previous photo" class="rounded border px-3 py-2 hover:bg-gray-50 disabled:opacity-40">←</button>
      <span data-position aria-live="polite" aria-atomic="true" class="tabular-nums">1 / {photos.length}</span>
      <button type="button" data-next aria-label="Next photo" class="rounded border px-3 py-2 hover:bg-gray-50 disabled:opacity-40">→</button>
    </div>
  </div>}
</review-photos>

<script>
  class ReviewPhotos extends HTMLElement {
    connectedCallback() {
      const slides = this.querySelector<HTMLElement>('[data-slides]')!;
      const controls = this.querySelector<HTMLElement>('[data-controls]');
      if (!controls) return;

      const prev = controls.querySelector<HTMLButtonElement>('[data-prev]')!;
      const next = controls.querySelector<HTMLButtonElement>('[data-next]')!;
      const position = controls.querySelector<HTMLElement>('[data-position]')!;
      const count = slides.children.length;
      const current = () => Math.round(slides.scrollLeft / slides.clientWidth);
      const update = () => {
        const index = current();
        prev.disabled = index <= 0;
        next.disabled = index >= count - 1;
        const label = `${index + 1} / ${count}`;
        if (position.textContent !== label) position.textContent = label;
      };
      const move = (offset: number) => slides.scrollTo({ left: (current() + offset) * slides.clientWidth });

      prev.onclick = () => move(-1);
      next.onclick = () => move(1);
      slides.onscroll = update;
      controls.hidden = false;
      update();
    }
  }
  customElements.define('review-photos', ReviewPhotos);
</script>
