---
import PhotoCarousel from './PhotoCarousel.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  data: CollectionEntry<'reviews'>['data'];
}
const { data } = Astro.props;
const date = data.dateCreated;
const photos = [...(data.cover ? [data.cover] : []), ...data.gallery];
---

<header>
  <p class="mb-2 text-sm text-gray-600">
    {data.category} · <time datetime={date.toISOString().slice(0, 10)}>{date.toLocaleDateString('en-US', { dateStyle: 'long', timeZone: 'UTC' })}</time>
  </p>
  <h1 class="text-4xl font-bold tracking-tight md:text-5xl">{data.title}</h1>
  <p class="mt-3 text-xl text-gray-700">{data.description}</p>
  <dl class="my-5 flex flex-wrap items-baseline gap-x-5 gap-y-2 text-sm">
    <div class="flex items-baseline gap-2 rounded-md bg-blue-50 px-3 py-1 text-blue-800">
      <dt>Overall</dt><dd class="text-lg font-semibold">{data.rating}/10</dd>
    </div>
    {Object.entries(data.aspects ?? {}).map(([aspect, score]) => (
      <div class="flex gap-2 text-gray-700"><dt>{aspect}</dt><dd class="font-semibold">{score}/10</dd></div>
    ))}
  </dl>
  {data.tags.length > 0 && <ul aria-label="Tags" class="mb-5 flex flex-wrap gap-x-3 text-sm">
    {data.tags.map(tag => <li><a class="text-blue-700 underline" href={`/tag/${encodeURIComponent(tag)}/`}>{tag}</a></li>)}
  </ul>}
  {photos.length > 0 && <PhotoCarousel photos={photos} />}
</header>
