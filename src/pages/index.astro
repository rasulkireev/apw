---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import FullWidthNewsletter from '../components/FullWidthNewsletter';

const pageTitle = "Rasul Kireev - Software Engineer & Digital Garden";
const pageDescription = "Welcome to Rasul Kireev's digital garden. Explore book reviews, programming tutorials, project ideas, and insights on web development, technology, and personal growth from a software engineer at Readwise.";
const pageKeywords = "Rasul Kireev, software engineer, digital garden, book reviews, programming tutorials, web development, Django, Python, JavaScript, project ideas, Readwise, personal blog";
---

<BaseLayout
  pageTitle={pageTitle}
  pageDescription={pageDescription}
  pageKeywords={pageKeywords}
>
  <div class="page-stack">
    <h1 class="page-title">Hey, I'm Rasul</h1>
    <p class="page-lede">
      I'm a software engineer. This website is my digital garden: a collection of things I've learned and created over the years.
    </p>

    <p class="page-lede">
      I like to
      <a
        class="text-link"
        href="/book-notes/"
      >read</a>,
      <a
        class="text-link"
        href="/articles/"
      >write</a>,
      <a
        class="text-link"
        href="/tutorials/"
      >code</a>,
      and do a lot of
      <a
        href="/projects"
        class="text-link"
      >other things</a>.
      You can read more about me,
      <a
        href="/about"
        class="text-link"
      >here</a>.
    </p>

    <div class="surface-panel home-start">
      <p>
        Good places to start:
      </p>
      <ul class="list-disc list-inside">
        <li>
          <a
            class="text-link"
            href="/favourites">
            My Favourites
          </a>
        </li>
        <li>
          <a class="text-link" href="/project-ideas">
            My Project Ideas
          </a> - Feel free to steal them.
        </li>
        <li>
          <a class="text-link" href="/free-books-and-courses">
            Free Books and Courses
          </a> - I found online over the years.
        </li>
        <li>
          <a class="text-link" href="/economical-writing">
            'Economical Writing' Book Review
          </a> - Most read book review on my site.
        </li>
        <li>
          <a class="text-link" href="/managing-django-with-poetry/">
            Managing a Django Project with Poetry
          </a> - Most read tutorial on my site.
        </li>
        <li>
          <a class="text-link" href="/10-years-of-great-books/">
            10 Years of Great Books
          </a> - Most read post on my site.
        </li>
      </ul>
    </div>

    <FullWidthNewsletter client:load
      title="Tuesday Letter"
      description="Consider signing up for my personal newsletter. I will share the most interesting articles and resources I've encountered during the week."
      tag="home"
    />

    <div>
      <SocialLinks />
    </div>

  </div>
</BaseLayout>
