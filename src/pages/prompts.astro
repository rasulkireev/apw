---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const pageTitle = "AI Prompts Collection by Rasul Kireev";
const pageDescription = "Discover my curated collection of effective AI prompts for ChatGPT, Claude, and other language models. Browse prompts by category and find the perfect prompt for your needs.";
const pageKeywords = "AI prompts, ChatGPT prompts, Claude prompts, prompt engineering, AI tools, language model prompts, prompt collection, Rasul Kireev";

const allPrompts = await getCollection('prompts');

// Sort articles by date
allPrompts.sort((a, b) => b.data.dateUpdated.valueOf() - a.data.dateUpdated.valueOf());

// Get unique tags from all articles
const allTags = [...new Set(allPrompts.flatMap(prompt => prompt.data.tags || []))].sort();

// Get the selected tags from URL params
const selectedTags = Astro.url.searchParams.get('tags')?.split(',').filter(Boolean) || [];

// Filter articles if tags are selected
const filteredPrompts = selectedTags.length > 0
  ? allPrompts.filter(prompt =>
      prompt.data.tags?.some(tag => selectedTags.includes(tag))
    )
  : allPrompts;
---

<BaseLayout
  pageTitle={pageTitle}
  pageDescription={pageDescription}
  pageKeywords={pageKeywords}
>
  <div class="page-stack">
    <div>
      <h1 class="section-title">Prompts</h1>
      <p class="page-lede">Reusable prompts for reading, analysis, writing, and working with language models.</p>
    </div>

    <div>
      <div class="control-row">
        <button
          id="toggleTags"
          class="control-button"
          aria-expanded="false"
          aria-controls="tagContainer"
        >
          Filter by tags
        </button>
      </div>

      <div id="tagContainer" class="tag-panel hidden">
        <div class="control-group">
          {allTags.map(tag => (
            <button
              class="chip tag-pill"
              data-tag={tag}
            >
              {tag}
            </button>
          ))}
        </div>
      </div>
    </div>

    <div class="entry-list">
      {filteredPrompts.map(p => (
        <div class="prompt-item" data-tags={p.data.tags?.join(',')}>
          <a
            href={"/" + p.slug}
            class="entry-card"
            itemprop="blogPost"
            itemscope
            itemtype="http://schema.org/BlogPosting"
          >
            <Image
              src={p.data.icon}
              width="50"
              height="50"
              alt={p.data.title}
              class="entry-icon"
              itemprop="image"
            />

            <div>
              <p class="entry-title">{ p.data.title }</p>
              <p class="entry-description" itemprop="headline">{ p.data.description }</p>
            </div>
          </a>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>

<script>
  const toggleButton = document.getElementById('toggleTags');
  const tagContainer = document.getElementById('tagContainer');
  const tagPills = document.querySelectorAll('.tag-pill');
  const promptItems = document.querySelectorAll('.prompt-item');

  // Toggle tag container visibility
  toggleButton?.addEventListener('click', () => {
    tagContainer?.classList.toggle('hidden');
    toggleButton.setAttribute('aria-expanded', String(!tagContainer?.classList.contains('hidden')));
  });

  // Handle tag selection
  tagPills.forEach(pill => {
    pill.addEventListener('click', () => {
      pill.classList.toggle('selected');

      // Get all selected tags
      const selectedTags = Array.from(document.querySelectorAll('.tag-pill.selected'))
        .map(el => el.getAttribute('data-tag'))
        .filter(Boolean);

      // Update URL without page reload
      const newUrl = new URL(window.location.href);
      if (selectedTags.length > 0) {
        newUrl.searchParams.set('tags', selectedTags.join(','));
      } else {
        newUrl.searchParams.delete('tags');
      }
      window.history.pushState({}, '', newUrl);

      // Filter articles client-side
      filterPrompts(selectedTags);
    });

    // Set initial selected state based on URL params
    const currentTags = new URLSearchParams(window.location.search).get('tags')?.split(',') || [];
    if (currentTags.includes(pill.getAttribute('data-tag'))) {
      pill.classList.add('selected');
    }
  });

  function filterPrompts(selectedTags) {
    document.querySelectorAll('.prompt-item').forEach(prompt => {
      const promptTags = prompt.getAttribute('data-tags')?.split(',') || [];
      const shouldShow = selectedTags.length === 0 ||
        selectedTags.some(tag => promptTags.includes(tag));
      prompt.style.display = shouldShow ? 'block' : 'none';
    });
  }

  // Initial filter on page load
  const initialTags = new URLSearchParams(window.location.search).get('tags')?.split(',').filter(Boolean) || [];
  filterPrompts(initialTags);
</script>
