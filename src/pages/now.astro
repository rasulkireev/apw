---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const pageTitle = "What I'm Up To Now - Rasul Kireev";
const pageDescription = "Discover what Rasul Kireev is currently working on, learning, and focusing on. A regularly updated 'now' page sharing current projects, interests, and life updates.";
const pageKeywords = "now page, current projects, what I'm doing, Rasul Kireev, current focus, life updates, personal updates, now";

const allNows = await getCollection('now');

let latestObject = allNows[0];
for (let i = 1; i < allNows.length; i++) {
  const currentDate = new Date(allNows[i].data.date);
  const latestDate = new Date(latestObject.data.date);

  if (currentDate > latestDate) {
    latestObject = allNows[i];
  }
}
const now = latestObject;


let options = { year: 'numeric', month: 'long', day: 'numeric' };
const date = new Date(now.data.date).toLocaleDateString(undefined, options);

const { Content } = await now.render();
---

<BaseLayout
  pageTitle={pageTitle}
  pageDescription={pageDescription}
  pageKeywords={pageKeywords}
>
  <section class="page-stack">
    <div>
      <h1 class="section-title p-name" itemprop="name">What I'm up to now</h1>
      <p class="entry-meta">
        Updated on <time datetime={new Date(now.data.date).toISOString()}>{ date }</time>
      </p>
    </div>

    <div class="prose">
      <Content />
    </div>

    <p class="page-lede">
      (This is a
      <a class="text-link" href="https://nownownow.com/">
        now
      </a>
      page, and if you have your own site,
      <a class="text-link" href="https://nownownow.com/about">
        you should make one
      </a>
      , too.)
    </p>
  </section>
</BaseLayout>
