---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { compareBooks } from '../lib/book-sort.mjs';

const pageTitle = "Book Reviews by Rasul Kireev";
const pageDescription = "Discover my comprehensive book reviews and ratings covering business, personal development, fiction, technology, and more. Find your next great read with detailed insights and honest opinions.";
const pageKeywords = "book reviews, book ratings, reading recommendations, business books, personal development, fiction reviews, technology books, book notes, reading list, Rasul Kireev";

const allBooks = await getCollection('books');

// Get the selected tags, category, and sort from URL params
const selectedTags = Astro.url.searchParams.get('tags')?.split(',').filter(Boolean) || [];
const selectedCategory = Astro.url.searchParams.get('category');
const selectedSort = Astro.url.searchParams.get('sort') || 'rating-desc';

// Sort books based on selected sort option
function sortBooks(books, sortOption) {
  return [...books].sort((a, b) => compareBooks(
    { ...a.data, slug: a.slug }, { ...b.data, slug: b.slug }, sortOption
  ));
}

const sortedBooks = sortBooks(allBooks, selectedSort);

// Get unique tags from all books
const allTags = [...new Set(allBooks.flatMap(book => book.data.tags || []))].sort();

// Get unique categories from all books
const allCategories = [...new Set(allBooks.map(book => book.data.category).filter(Boolean))].sort();

// Filter books if tags or category are selected
const filteredBooks = sortedBooks.filter(book => {
  const matchesTags = selectedTags.length === 0 ||
    book.data.tags?.some(tag => selectedTags.includes(tag));
  const matchesCategory = !selectedCategory ||
    book.data.category === selectedCategory;
  return matchesTags && matchesCategory;
});
---

<BaseLayout
  pageTitle={pageTitle}
  pageDescription={pageDescription}
  pageKeywords={pageKeywords}
>
  <h1 class="mb-4 text-3xl font-bold">Book Reviews</h1>
  <div class="mb-4 space-y-4">
    <div id="bookSearchControls" role="search" aria-label="Find a book review" class="hidden space-y-2">
      <label for="bookSearch" class="block text-sm font-medium text-gray-700">Search by title or author</label>
      <div class="flex gap-2">
        <input
          id="bookSearch"
          type="search"
          autocomplete="off"
          maxlength="100"
          aria-controls="bookResults"
          class="min-w-0 flex-1 px-4 py-2 text-gray-900 bg-white border border-gray-300 rounded-md"
        />
        <button id="clearBookSearch" type="button" disabled class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50 disabled:opacity-50">Clear search</button>
      </div>
    </div>
    <div class="flex flex-wrap justify-between items-center gap-2">
      <div class="flex flex-wrap gap-2">
        <button
          id="toggleTags"
          type="button"
          aria-controls="tagContainer"
          aria-expanded="false"
          class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50"
        >
          Filter by tags
        </button>

        <select
          id="categoryFilter"
          aria-label="Book category"
          class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50"
        >
          <option value="">All Categories</option>
          {allCategories.map(category => (
            <option
              value={category}
              selected={category === selectedCategory}
            >
              {category}
            </option>
          ))}
        </select>
      </div>

      <div class="flex flex-wrap gap-2">
        <select
          id="sortFilter"
          aria-label="Sort books"
          class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50"
        >
          <option value="rating-desc" selected={selectedSort === 'rating-desc'}>Rating (High to Low)</option>
          <option value="rating-asc" selected={selectedSort === 'rating-asc'}>Rating (Low to High)</option>
          <option value="date-desc" selected={selectedSort === 'date-desc'}>Date Read (Newest First)</option>
          <option value="date-asc" selected={selectedSort === 'date-asc'}>Date Read (Oldest First)</option>
        </select>
      </div>
    </div>

    <div id="tagContainer" class="hidden mt-4 space-y-2">
      <div class="flex flex-wrap gap-2">
        {allTags.map(tag => (
          <button
            class="px-3 py-1 text-sm text-gray-700 bg-white rounded-full hover:bg-gray-50 tag-pill"
            data-tag={tag}
            type="button"
            aria-pressed="false"
          >
            {tag}
          </button>
        ))}
      </div>
    </div>
  </div>

  <p id="bookResultCount" role="status" aria-live="polite" aria-atomic="true" class="mb-4 text-sm text-gray-600"></p>
  <p id="bookEmptyState" hidden class="my-4 text-gray-700">No books match. Try another title or author, or adjust your filters.</p>
  <div id="bookResults">
  {filteredBooks.map(p => (
    <div class="mb-1 book-item" data-slug={p.slug} data-rating={p.data.rating} data-title={p.data.title} data-author={p.data.author} data-tags={p.data.tags?.join(',')} data-category={p.data.category} data-date-read={p.data.dateRead}>
      <a
        href={"/" + p.slug}
        class="flex flex-col items-center p-3 space-x-0 space-y-2 text-xl text-gray-900 border-0 rounded-lg md:space-x-4 md:flex-row hover:bg-gray-200"
      >
        <Image
          src={p.data.cover}
          alt={p.data.title}
          class="self-start inline w-24 h-auto align-middle md:pt-3"
        />

        <div class="md:flex-col md:space-y-2 md:flex">
          <div class="flex flex-col space-y-2">
            <p class="text-xl font-semibold md:text-2xl">{ p.data.title } by { p.data.author }</p>
            <p class="text-sm text-gray-600">Rating: <span class="rating-value">{ p.data.rating }</span>/10</p>
            <p class="text-sm text-gray-600">Date Read: {p.data.dateRead.toLocaleDateString('en-us', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
            <p class="m-0 text-base text-gray-800">
              { p.data.description }
            </p>
          </div>
        </div>
      </a>
    </div>
  ))}
  </div>
</BaseLayout>

<script>
  import { compareBooks } from '../lib/book-sort.mjs';
  import { matchesBookSearch } from '../lib/book-search.mjs';

  const toggleButton = document.getElementById('toggleTags');
  const tagContainer = document.getElementById('tagContainer');
  const tagPills = document.querySelectorAll('.tag-pill');
  const bookItems = document.querySelectorAll('.book-item');
  const categoryFilter = document.getElementById('categoryFilter');
  const sortFilter = document.getElementById('sortFilter');
  const searchInput = document.getElementById('bookSearch') as HTMLInputElement;
  const clearSearch = document.getElementById('clearBookSearch') as HTMLButtonElement;
  const resultCount = document.getElementById('bookResultCount');
  const emptyState = document.getElementById('bookEmptyState');

  // Search stays in the current page only: no URL, storage or analytics payload.
  searchInput.addEventListener('input', filterAndSortBooks);
  clearSearch.addEventListener('click', () => {
    searchInput.value = '';
    filterAndSortBooks();
    searchInput.focus();
  });
  document.getElementById('bookSearchControls')?.classList.remove('hidden');

  // Toggle tag container visibility
  toggleButton?.addEventListener('click', () => {
    const isHidden = tagContainer?.classList.toggle('hidden');
    toggleButton.setAttribute('aria-expanded', String(!isHidden));
  });

  // Handle category selection
  categoryFilter?.addEventListener('change', (e) => {
    const select = e.target as HTMLSelectElement;
    const selectedCategory = select.value;

    // Update URL without page reload
    const newUrl = new URL(window.location.href);
    if (selectedCategory) {
      newUrl.searchParams.set('category', selectedCategory);
    } else {
      newUrl.searchParams.delete('category');
    }
    window.history.pushState({}, '', newUrl);

    filterAndSortBooks();
  });

  // Handle sort selection
  sortFilter?.addEventListener('change', (e) => {
    const select = e.target as HTMLSelectElement;
    const selectedSort = select.value;

    // Update URL without page reload
    const newUrl = new URL(window.location.href);
    newUrl.searchParams.set('sort', selectedSort);
    window.history.pushState({}, '', newUrl);

    filterAndSortBooks();
  });

  // Handle tag selection
  tagPills.forEach(pill => {
    pill.addEventListener('click', () => {
      pill.classList.toggle('selected');
      pill.classList.toggle('bg-gray-100');
      pill.classList.toggle('border');
      pill.classList.toggle('border-blue-500');
      pill.setAttribute('aria-pressed', String(pill.classList.contains('selected')));

      // Get all selected tags
      const selectedTags = Array.from(document.querySelectorAll('.tag-pill.selected'))
        .map(el => el.getAttribute('data-tag'))
        .filter(Boolean);

      // Update URL without page reload
      const newUrl = new URL(window.location.href);
      if (selectedTags.length > 0) {
        newUrl.searchParams.set('tags', selectedTags.join(','));
      } else {
        newUrl.searchParams.delete('tags');
      }
      window.history.pushState({}, '', newUrl);

      filterAndSortBooks();
    });
  });

  // Static HTML has build-time defaults. Restore controls from the actual URL
  // on arrival and on Back/Forward before deriving the visible book list.
  function restoreFromUrl() {
    const params = new URLSearchParams(window.location.search);
    const category = categoryFilter as HTMLSelectElement;
    const sort = sortFilter as HTMLSelectElement;
    const requestedCategory = params.get('category') || '';
    const requestedSort = params.get('sort') || 'rating-desc';
    category.value = Array.from(category.options).some(option => option.value === requestedCategory)
      ? requestedCategory : '';
    sort.value = Array.from(sort.options).some(option => option.value === requestedSort)
      ? requestedSort : 'rating-desc';
    const tags = params.get('tags')?.split(',').filter(Boolean) || [];
    tagPills.forEach(pill => {
      const selected = tags.includes(pill.getAttribute('data-tag') || '');
      ['selected', 'bg-gray-100', 'border', 'border-blue-500'].forEach(name => {
        pill.classList.toggle(name, selected);
      });
      pill.setAttribute('aria-pressed', String(selected));
    });
    if (document.querySelector('.tag-pill.selected')) {
      tagContainer?.classList.remove('hidden');
      toggleButton?.setAttribute('aria-expanded', 'true');
    }
    filterAndSortBooks();
  }

  function sortBooksClient(books, sortOption) {
    const values = book => ({
      slug: book.getAttribute('data-slug') || '',
      title: book.getAttribute('data-title') || '',
      author: book.getAttribute('data-author') || '',
      rating: Number(book.getAttribute('data-rating') || '0'),
      dateRead: book.getAttribute('data-date-read') || '',
    });
    return Array.from(books).sort((a, b) => compareBooks(values(a), values(b), sortOption));
  }

  function filterAndSortBooks() {
    const selectedTags = Array.from(document.querySelectorAll('.tag-pill.selected'))
      .map(el => el.getAttribute('data-tag'))
      .filter(Boolean);
    const selectedCategory = (categoryFilter as HTMLSelectElement).value;
    const selectedSort = (sortFilter as HTMLSelectElement).value;

    // First filter books
    const visibleBooks = [];
    const hiddenBooks = [];

    bookItems.forEach(book => {
      const bookTags = book.getAttribute('data-tags')?.split(',').filter(Boolean) || [];
      const bookCategory = book.getAttribute('data-category');

      const matchesTags = selectedTags.length === 0 ||
        selectedTags.some(tag => bookTags.includes(tag));
      const matchesCategory = !selectedCategory ||
        bookCategory === selectedCategory;

      const matchesSearch = matchesBookSearch(
        book.getAttribute('data-title') || '',
        book.getAttribute('data-author') || '',
        searchInput.value
      );
      if (matchesTags && matchesCategory && matchesSearch) {
        visibleBooks.push(book);
        book.style.display = '';
      } else {
        hiddenBooks.push(book);
        book.style.display = 'none';
      }
    });

    if (resultCount) resultCount.textContent = `${visibleBooks.length} of ${bookItems.length} books`;
    if (emptyState) emptyState.hidden = visibleBooks.length !== 0;
    clearSearch.disabled = searchInput.value.length === 0;

    // Then sort visible books
    const sortedBooks = sortBooksClient(visibleBooks, selectedSort);

    // Get the parent container
    const container = bookItems[0]?.parentNode;
    if (container) {
      // Remove all books from DOM
      bookItems.forEach(book => book.remove());

      // Add sorted visible books back
      sortedBooks.forEach(book => container.appendChild(book));

      // Add hidden books at the end (they won't be visible anyway)
      hiddenBooks.forEach(book => container.appendChild(book));
    }
  }

  window.addEventListener('popstate', restoreFromUrl);
  restoreFromUrl();
</script>
