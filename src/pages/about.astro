---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import Link from '../components/Link.astro';
import FloatingNote from '../components/FloatingNote.astro';

const pageTitle = "About Rasul Kireev";
const pageDescription = "Learn about Rasul Kireev - Software Developer at Readwise, passionate about web development, writing, and experimenting with new technologies and hobbies.";
const pageKeywords = "Rasul Kireev, about, software developer, Readwise, web development, programming, writing, tutorials, YouTube, kombucha, fermentation, bread baking";
const pageType = "profile";
---

<BaseLayout
  pageTitle={pageTitle}
  pageDescription={pageDescription}
  pageKeywords={pageKeywords}
  pageType={pageType}
>
  <div class="prose page-stack">
      <h1>About me</h1>

      <p>My name is Rasul.</p>
      <p>I write code at <Link class="underline" href="https://readwise.io">Readwise</Link>.</p>

      <p>
        In my free time, I love to do more web dev. More specifically, I like to develop small and fun projects that help
        me learn new technologies. You can see a list of my projects <a href="/projects/">here</a>.
      </p>

      <p>
        As a programmer, I learned to love writing. I try to write regularly, be it <a href="/tutorials/">
        tech tutorials</a> or about <a href="/articles/">any other topic</a>. An extension of written
        tech tutorials was to start making videos. For that, you can check
        <Link href="https://www.youtube.com/channel/UC-r4_CjDp4n4O-36rnUe8gg">my Youtube channel</Link>.
      </p>

      <p>
        I like to <FloatingNote note="depends on the mood." tone="info">experiment</FloatingNote> a lot. Trying something new is a passion of mine. Some of my recent successes were with
        brewing Kombucha, fermenting different foods, and baking bread. On the failure side of things, I can't keep
        a plant alive for more than a week.
      </p>

      <section class="surface-panel not-prose p-5">
        <h2 class="newsletter-title">Learn more about me with MCP</h2>
        <p>
          I run a small public Model Context Protocol (MCP) server at
          <Link href="https://mcp.rasulkireev.com">mcp.rasulkireev.com</Link>. If you are using an AI assistant
          or hiring workflow that supports remote MCP servers, you can connect it to learn more about my public work,
          strengths, work style, and current focus.
        </p>
        <p>
          Use <code>https://mcp.rasulkireev.com/mcp</code> as the MCP endpoint. The server currently exposes the
          <code>get_profile</code> tool, the <code>profile://rasul</code> resource, and an <code>evaluate_fit</code>
          prompt for comparing my public profile against a role or opportunity.
        </p>
      </section>

      <SocialLinks />
  </div>
</BaseLayout>
